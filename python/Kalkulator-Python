
print("      KALKULATOR PYTHON")
print("============================")

angka1 = float(input("Masukkan angka pertama: "))
operator = input("Masukkan operator (+ - * /): ")
angka2 = float(input("Masukkan angka kedua: "))

if operator == "+":
    hasil = angka1 + angka2
    print("Hasil:", hasil)

elif operator == "-":
    hasil = angka1 - angka2
    print("Hasil:", hasil)

elif operator == "*":
    hasil = angka1 * angka2
    print("Hasil:", hasil)

elif operator == "/":
    if angka2 != 0:
        hasil = angka1 / angka2
        print("Hasil:", hasil)
    else:
        print("Tidak bisa membagi dengan 0!")

else:
    print("Operator tidak valid!")

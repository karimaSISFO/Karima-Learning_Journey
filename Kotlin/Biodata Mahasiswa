fun main() {

    println("==============================")
    println("       BIODATA MAHASISWA")
    println("==============================")

    print("Nama       : ")
    val nama = readLine() ?: ""

    print("NIM        : ")
    val nim = readLine() ?: ""

    print("Jurusan    : ")
    val jurusan = readLine() ?: ""

    print("Semester   : ")

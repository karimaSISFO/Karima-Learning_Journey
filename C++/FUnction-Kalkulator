#include <iostream>
using namespace std;

double tambah(double a, double b) {
    return a + b;
}

double kurang(double a, double b) {
    return a - b;
}

double kali(double a, double b) {
    return a * b;
}

double bagi(double a, double b) {
    return a / b;
}

int main() {

    double angka1, angka2;
    int pilihan;

    cout << "============================" << endl;
    cout << "    KALKULATOR FUNCTION" << endl;
    cout << "============================" << endl;

    cout << "Masukkan angka pertama : ";
    cin >> angka1;

    cout << "Masukkan angka kedua   : ";
    cin >> angka2;

    cout << "\nPilih operasi:" << endl;
    cout << "1. Penjumlahan" << endl;
    cout << "2. Pengurangan" << endl;
    cout << "3. Perkalian" << endl;
    cout << "4. Pembagian" << endl;
    cout << "Pilihan: ";
    cin >> pilihan;

    cout << "\n============================" << endl;

    switch (pilihan) {

        case 1:
            cout << "Hasil: " << tambah(angka1, angka2) << endl;
            break;

        case 2:
            cout << "Hasil: " << kurang(angka1, angka2) << endl;
            break;

        case 3:
            cout << "Hasil: " << kali(angka1, angka2) << endl;
            break;

        case 4:
            if (angka2 != 0) {
                cout << "Hasil: " << bagi(angka1, angka2) << endl;
            } else {
                cout << "Tidak bisa membagi dengan 0!" << endl;
            }
            break;

        default:
            cout << "Pilihan tidak tersedia!" << endl;
    }

    cout << "============================" << endl;

    return 0;
}

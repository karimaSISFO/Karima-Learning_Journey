#include <iostream>
using namespace std;

int main() {

    int jumlah;
    float nilai[100];
    float total = 0;
    float rataRata;
    float tertinggi, terendah;

    cout << "================================" << endl;
    cout << "   DATA NILAI MAHASISWA" << endl;
    cout << "================================" << endl;

    cout << "Masukkan jumlah mahasiswa: ";
    cin >> jumlah;

    for (int i = 0; i < jumlah; i++) {
        cout << "Nilai mahasiswa ke-" << i + 1 << ": ";
        cin >> nilai[i];

        total += nilai[i];
    }

    tertinggi = nilai[0];
    terendah = nilai[0];

    for (int i = 1; i < jumlah; i++) {

        if (nilai[i] > tertinggi) {
            tertinggi = nilai[i];
        }

        if (nilai[i] < terendah) {
            terendah = nilai[i];
        }
    }

    rataRata = total / jumlah;

    cout << "\n================================" << endl;
    cout << "          HASIL DATA" << endl;
    cout << "================================" << endl;

    cout << "Daftar nilai:" << endl;

    for (int i = 0; i < jumlah; i++) {
        cout << "Mahasiswa ke-" << i + 1
             << " : " << nilai[i] << endl;
    }

    cout << "\nTotal nilai    : " << total << endl;
    cout << "Rata-rata      : " << rataRata << endl;
    cout << "Nilai tertinggi: " << tertinggi << endl;
    cout << "Nilai terendah : " << terendah << endl;

    return 0;
}
